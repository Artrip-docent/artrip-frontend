<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingTop="40dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- ARTRIP Logo with slight overlap -->
    <FrameLayout
        android:id="@+id/logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logo2"
            android:layout_width="24dp"
            android:layout_height="30dp"
            android:src="@drawable/logo2"
            android:contentDescription="Palette Icon" />

        <ImageView
            android:id="@+id/logo1"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:src="@drawable/logo1"
            android:contentDescription="ARTRIP Text Logo" />

    </FrameLayout>

    <!-- Screen Title -->
    <TextView
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logo_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp" />

    <!-- Email Input Field -->
    <EditText
        android:id="@+id/emailInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="이메일"
        android:textSize="15dp"
        android:background="@null"
        android:padding="0dp"
        android:layout_marginLeft="15dp"
        app:layout_constraintTop_toBottomOf="@id/loginTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp" />

    <!-- Email Underline -->
    <View
        android:id="@+id/emailUnderline"
        android:layout_width="350dp"
        android:layout_height="1dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/emailInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Password Input Field -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="비밀번호"
        android:textSize="15dp"
        android:inputType="textPassword"
        android:background="@null"
        android:padding="0dp"
        android:layout_marginLeft="15dp"
        app:layout_constraintTop_toBottomOf="@id/emailUnderline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Password Underline -->
    <View
        android:id="@+id/passwordUnderline"
        android:layout_width="350dp"
        android:layout_height="1dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/passwordInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Forgot Password Link -->
    <TextView
        android:id="@+id/textForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 찾기"
        android:textSize="12sp"
        android:textColor="#999999"
        android:clickable="true"
        android:layout_marginRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/passwordUnderline"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp" />

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/login"
        android:layout_width="330dp"
        android:layout_height="60dp"
        android:text="로그인"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2C2C2C"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/textForgotPassword"
        android:layout_marginTop="200dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Social Login Text -->
    <TextView
        android:id="@+id/socialText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="소셜 계정으로 간편 로그인"
        android:textSize="11sp"
        android:textColor="#999999"
        app:layout_constraintTop_toBottomOf="@id/login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp" />

    <!-- Kakao Icon -->
    <ImageView
        android:id="@+id/kakao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/kakao"
        android:contentDescription="Kakao Icon"
        app:layout_constraintTop_toBottomOf="@id/socialText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
