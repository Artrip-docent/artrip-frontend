<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1) 카메라 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="560dp"
        android:layout_margin="20dp"
        android:contentDescription="Camera Preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/capture_button" />

    <!-- 2) 촬영 버튼을 ImageView로 교체 -->
    <ImageView
        android:id="@+id/capture_button"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:src="@drawable/ic_camerabutton"
        android:contentDescription="Capture Button"
        app:layout_constraintTop_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_bg"
        android:layout_marginBottom="15dp" />

    <!-- Bottom Navigation Bar (updated to match MyPage) -->
    <FrameLayout
        android:id="@+id/bottom_nav_bg"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:src="@drawable/ic_bar"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nav_home"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_weight="1"
            android:src="@drawable/ic_art"
            android:contentDescription="Home" />

        <ImageView
            android:id="@+id/nav_camera"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_weight="1"
            android:src="@drawable/ic_camera_fill"
            android:contentDescription="Camera" />

        <ImageView
            android:id="@+id/nav_profile"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_weight="1"
            android:src="@drawable/ic_user_fill"
            android:contentDescription="Profile" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
