<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#FFFFFF">


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전시회 목록"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"/>
    </LinearLayout>


    <!-- Bottom Navigation with Gray Bar and Icons on Top -->
    <FrameLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="8dp">

        <!-- Gray Bar Background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:src="@drawable/frame"
            android:contentDescription="Bottom navigation background bar" />

        <!-- Icons on top of the Gray Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="4">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/art"
                android:contentDescription="Home Icon"
                android:layout_margin="4dp" />

            <ImageView
                android:id="@+id/Camera_Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/camera"
                android:contentDescription="Camera Icon"
                android:layout_margin="4dp" />

            <ImageView
                android:id="@+id/Commu_Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/community"
                android:contentDescription="Chat Icon"
                android:layout_margin="4dp" />

            <ImageView
                android:id="@+id/mypage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:src="@drawable/whitemypage"
                android:contentDescription="Profile Icon"
                android:layout_margin="4dp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>